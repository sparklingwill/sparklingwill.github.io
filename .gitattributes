# The repo is edited from both Windows and macOS. Normalise every text file
# to LF in the index so a checkout on either machine stops rewriting whole
# files and burying real changes in line-ending churn.
* text=auto eol=lf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.zip binary
